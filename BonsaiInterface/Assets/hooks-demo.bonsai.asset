%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12e75434ce01d27418bd8bdda2586480, type: 3}
  m_Name: hooks-demo.bonsai
  m_EditorClassIdentifier: 
  WorkflowBuilderData: "<?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<WorkflowBuilder Version=\"2.9.1\"\r\n                 xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\r\n                 xmlns:rx=\"clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core\"\r\n                 xmlns:sys=\"clr-namespace:System;assembly=mscorlib\"\r\n                 xmlns=\"https://bonsai-rx.org/2018/workflow\">\r\n  <Workflow>\r\n    <Nodes>\r\n      <!-- LED blink. Unity: InjectSubscription / InjectImmediateSubscription on LedOn and LedOff,\r\n           SetNodeProperty on this Timer's Period, GetExternalizedTimeSpan(\"LedOnTime\").\r\n           For a real LED, add an Arduino DigitalOutput after LedOn (true) and LedOff (false). -->\r\n      <Expression xsi:type=\"Combinator\">\r\n        <Combinator xsi:type=\"rx:Timer\">\r\n          <rx:DueTime>PT0S</rx:DueTime>\r\n          <rx:Period>PT1S</rx:Period>\r\n        </Combinator>\r\n      </Expression>\r\n      <Expression xsi:type=\"rx:PublishSubject\">\r\n        <Name>LedOn</Name>\r\n      </Expression>\r\n      <Expression xsi:type=\"SubscribeSubject\">\r\n        <Name>LedOn</Name>\r\n      </Expression>\r\n      <Expression xsi:type=\"ExternalizedMapping\">\r\n        <Property Name=\"DueTime\" DisplayName=\"LedOnTime\" />\r\n      </Expression>\r\n      <Expression xsi:type=\"Combinator\">\r\n        <Combinator xsi:type=\"rx:Delay\">\r\n          <rx:DueTime>PT0.2S</rx:DueTime>\r\n        </Combinator>\r\n      </Expression>\r\n      <Expression xsi:type=\"rx:PublishSubject\">\r\n        <Name>LedOff</Name>\r\n      </Expression>\r\n      <!-- Keystrokes. Unity: SendToSubject pushes each key into UnityKey; InjectSubscription reads KeyEcho. -->\r\n      <Expression xsi:type=\"rx:PublishSubject\" TypeArguments=\"sys:String\">\r\n        <rx:Name>UnityKey</rx:Name>\r\n      </Expression>\r\n      <Expression xsi:type=\"SubscribeSubject\">\r\n        <Name>UnityKey</Name>\r\n      </Expression>\r\n      <Expression xsi:type=\"rx:PublishSubject\">\r\n        <Name>KeyEcho</Name>\r\n      </Expression>\r\n      <!-- Slider. Unity: InjectInput replaces SliderInput with a Unity source; InjectSubscription reads SliderEcho. -->\r\n      <Expression xsi:type=\"ExternalizedMapping\">\r\n        <Property Name=\"Value\" DisplayName=\"SliderInput\" />\r\n      </Expression>\r\n      <Expression xsi:type=\"Combinator\">\r\n        <Combinator xsi:type=\"FloatProperty\">\r\n          <Value>0</Value>\r\n        </Combinator>\r\n      </Expression>\r\n      <Expression xsi:type=\"rx:PublishSubject\">\r\n        <Name>SliderEcho</Name>\r\n      </Expression>\r\n      <!-- Trigger. In Bonsai alone the Timer fires every 3 s. Unity: ReplaceSource swaps it for the Space bar,\r\n           and every hook on this group passes groupPath \"TrialTrigger\". -->\r\n      <Expression xsi:type=\"GroupWorkflow\">\r\n        <Name>TrialTrigger</Name>\r\n        <Workflow>\r\n          <Nodes>\r\n            <Expression xsi:type=\"Combinator\">\r\n              <Combinator xsi:type=\"rx:Timer\">\r\n                <rx:DueTime>PT3S</rx:DueTime>\r\n                <rx:Period>PT3S</rx:Period>\r\n              </Combinator>\r\n            </Expression>\r\n            <Expression xsi:type=\"rx:PublishSubject\">\r\n              <Name>Trigger</Name>\r\n            </Expression>\r\n          </Nodes>\r\n          <Edges>\r\n            <Edge From=\"0\" To=\"1\" Label=\"Source1\" />\r\n          </Edges>\r\n        </Workflow>\r\n      </Expression>\r\n    </Nodes>\r\n    <Edges>\r\n      <Edge From=\"0\" To=\"1\" Label=\"Source1\" />\r\n      <Edge From=\"2\" To=\"4\" Label=\"Source1\" />\r\n      <Edge From=\"3\" To=\"4\" Label=\"Source2\" />\r\n      <Edge From=\"4\" To=\"5\" Label=\"Source1\" />\r\n      <Edge From=\"7\" To=\"8\" Label=\"Source1\" />\r\n      <Edge From=\"9\" To=\"10\" Label=\"Source1\" />\r\n      <Edge From=\"10\" To=\"11\" Label=\"Source1\" />\r\n    </Edges>\r\n  </Workflow>\r\n</WorkflowBuilder>"

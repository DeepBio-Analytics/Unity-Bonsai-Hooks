%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12e75434ce01d27418bd8bdda2586480, type: 3}
  m_Name: arduino-blink.bonsai
  m_EditorClassIdentifier: Assembly-CSharp::BonsaiWorkflowAsset
  WorkflowBuilderData: "<?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<WorkflowBuilder Version=\"2.9.2\"\r\n                 xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\r\n                 xmlns:ard=\"clr-namespace:Bonsai.Arduino;assembly=Bonsai.Arduino\"\r\n                 xmlns:rx=\"clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core\"\r\n                 xmlns:scr=\"clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions\"\r\n                 xmlns:sys=\"clr-namespace:System;assembly=mscorlib\"\r\n                 xmlns:wie=\"clr-namespace:Bonsai.Windows.Input;assembly=Bonsai.Windows.Input\"\r\n                 xmlns=\"https://bonsai-rx.org/2018/workflow\">\r\n  <Workflow>\r\n    <Nodes>\r\n      <Expression xsi:type=\"Combinator\">\r\n        <Combinator xsi:type=\"ard:CreateArduino\">\r\n          <ard:Name>OutputArduino</ard:Name>\r\n          <ard:PortName>COM6</ard:PortName>\r\n          <ard:BaudRate>115200</ard:BaudRate>\r\n          <ard:SamplingInterval>19</ard:SamplingInterval>\r\n        </Combinator>\r\n      </Expression>\r\n      <Expression xsi:type=\"Combinator\">\r\n        <Combinator xsi:type=\"rx:Timer\">\r\n          <rx:DueTime>PT0.5S</rx:DueTime>\r\n          <rx:Period>PT0.5S</rx:Period>\r\n        </Combinator>\r\n      </Expression>\r\n      <Expression xsi:type=\"Combinator\">\r\n        <Combinator xsi:type=\"rx:TimeInterval\" />\r\n      </Expression>\r\n      <Expression xsi:type=\"scr:ExpressionTransform\">\r\n        <scr:Expression>1.0 / (2.0 * Interval.TotalSeconds)</scr:Expression>\r\n      </Expression>\r\n      <Expression xsi:type=\"rx:PublishSubject\">\r\n        <Name>BlinkRate</Name>\r\n      </Expression>\r\n      <Expression xsi:type=\"scr:ExpressionTransform\">\r\n        <scr:Expression>it % 2 == 0</scr:Expression>\r\n      </Expression>\r\n      <Expression xsi:type=\"SubscribeSubject\">\r\n        <Name>BlinkEnabled</Name>\r\n      </Expression>\r\n      <Expression xsi:type=\"Combinator\">\r\n        <Combinator xsi:type=\"rx:CombineLatest\" />\r\n      </Expression>\r\n      <Expression xsi:type=\"scr:ExpressionTransform\">\r\n        <scr:Expression>Item1 &amp;&amp; Item2</scr:Expression>\r\n      </Expression>\r\n      <Expression xsi:type=\"Combinator\">\r\n        <Combinator xsi:type=\"rx:ObserveOn\">\r\n          <rx:Scheduler>ThreadPoolScheduler</rx:Scheduler>\r\n        </Combinator>\r\n      </Expression>\r\n      <Expression xsi:type=\"Combinator\">\r\n        <Combinator xsi:type=\"ard:DigitalOutput\">\r\n          <ard:PortName>OutputArduino</ard:PortName>\r\n          <ard:Pin>4</ard:Pin>\r\n        </Combinator>\r\n      </Expression>\r\n      <Expression xsi:type=\"rx:PublishSubject\">\r\n        <Name>LedState</Name>\r\n      </Expression>\r\n      <Expression xsi:type=\"rx:PublishSubject\" TypeArguments=\"sys:Boolean\">\r\n        <rx:Name>BlinkEnabled</rx:Name>\r\n      </Expression>\r\n      <Expression xsi:type=\"Combinator\">\r\n        <Combinator xsi:type=\"wie:KeyDown\">\r\n          <wie:Filter>Space</wie:Filter>\r\n          <wie:SuppressRepetitions>true</wie:SuppressRepetitions>\r\n        </Combinator>\r\n      </Expression>\r\n      <Expression xsi:type=\"Combinator\">\r\n        <Combinator xsi:type=\"rx:ElementIndex\" />\r\n      </Expression>\r\n      <Expression xsi:type=\"scr:ExpressionTransform\">\r\n        <scr:Expression>Index % 2 == 0</scr:Expression>\r\n      </Expression>\r\n      <Expression xsi:type=\"MulticastSubject\">\r\n        <Name>BlinkEnabled</Name>\r\n      </Expression>\r\n    </Nodes>\r\n    <Edges>\r\n      <Edge From=\"1\" To=\"2\" Label=\"Source1\" />\r\n      <Edge From=\"1\" To=\"5\" Label=\"Source1\" />\r\n      <Edge From=\"2\" To=\"3\" Label=\"Source1\" />\r\n      <Edge From=\"3\" To=\"4\" Label=\"Source1\" />\r\n      <Edge From=\"5\" To=\"7\" Label=\"Source1\" />\r\n      <Edge From=\"6\" To=\"7\" Label=\"Source2\" />\r\n      <Edge From=\"7\" To=\"8\" Label=\"Source1\" />\r\n      <Edge From=\"8\" To=\"9\" Label=\"Source1\" />\r\n      <Edge From=\"8\" To=\"11\" Label=\"Source1\" />\r\n      <Edge From=\"9\" To=\"10\" Label=\"Source1\" />\r\n      <Edge From=\"13\" To=\"14\" Label=\"Source1\" />\r\n      <Edge From=\"14\" To=\"15\" Label=\"Source1\" />\r\n      <Edge From=\"15\" To=\"16\" Label=\"Source1\" />\r\n    </Edges>\r\n  </Workflow>\r\n</WorkflowBuilder>"
